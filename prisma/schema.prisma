generator client {
  provider = "prisma-client-js"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users and sign-in
// ---------------------------------------------------------------------------

/// A verified phone number. Every user can both dispatch and claim orders.
model User {
  id                   String              @id @default(cuid())
  countryCode          String
  phone                String
  locale               String              @default("zh-Hant")
  /// Default for new orders: minutes before pickup when the winning driver may see
  /// the passenger's contact. Null means as soon as the order is claimed.
  contactRevealMinutes Int?                @default(60)
  /// Default for new orders: whether they are also listed in the 接單池.
  poolByDefault        Boolean             @default(false)
  /// 停用: set by the platform's staff for abuse. A suspended user cannot sign in
  /// and every session they had stops working; their past orders stay as they are.
  suspendedAt          DateTime?
  suspendedReason      String?
  /// 通知設定: the kinds of notification (NotificationGroup) this user turned off. Nothing is
  /// recorded for them. The alert sound and its tone are kept on each phone, not here.
  notificationsOff     NotificationGroup[] @default([])
  /// 更新說明彈窗: the version of UpdateNotice this user has closed; a newer one pops up once.
  updateNoticeSeen     Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  profile              DriverProfile?
  sessions             Session[]
  dispatchedOrders     Order[]               @relation("OrderDispatcher")
  claimedOrders        Order[]               @relation("OrderClaimer")
  /// 我的司機: the dispatcher's own marks and notes on drivers who took their orders.
  driverNotes          DriverNote[]          @relation("DriverNoteOwner")
  notedBy              DriverNote[]          @relation("DriverNoteDriver")
  claims               OrderClaim[]
  subscriptions        Subscription[]
  entitlementOverrides EntitlementOverride[]
  usages               Usage[]
  creditAccount        CreditAccount?
  creditEntries        CreditEntry[]
  lead                 Lead?
  groupInvites         GroupInvite[]
  paymentMethods       PaymentMethod[]
  supportConversation  SupportConversation?
  profilePage          ProfilePage?
  notifications        Notification[]
  /// 拼車 this user opened.
  carpools             Carpool[]
  /// 特價車 this user put up.
  deals                Deal[]

  @@unique([countryCode, phone])
}

/// Filled in once, the first time a driver claims an order.
model DriverProfile {
  userId           String       @id
  name             String
  /// 車輛歸屬地 and 車牌類型 decide which plates the car has and their format.
  /// Null on profiles saved before these were asked.
  vehicleOwnership PlateRegion?
  plateType        PlateType?
  hkPlate          String?
  macauPlate       String?
  mainlandPlate    String?
  vehicleType      String?
  seats            Int?
  color            String?
  /// The numbers to reach the driver on each side of the border, as typed in
  /// the profile ("+852 91234567", "+86 13800001111"). Neither is verified by
  /// SMS; the sign-in number is. Optional: not every driver has both.
  hkMacauPhone     String?
  mainlandPhone    String?
  /// The driver chose not to show their plates to passengers. The dispatcher
  /// still sees them; the passenger's page says to ask before boarding.
  hidePlates       Boolean      @default(false)
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VerificationMode {
  SMS
  DEVELOPMENT
}

/// One-time sign-in code. Only a salted hash of the code is stored. The mode and
/// hash are fixed when the code is requested; changing the development setting
/// later never changes how an issued code is checked.
model VerificationCode {
  id          String           @id @default(cuid())
  countryCode String
  phone       String
  mode        VerificationMode @default(SMS)
  codeHash    String
  ip          String?
  attempts    Int              @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([countryCode, phone, createdAt])
  @@index([ip, createdAt])
}

/// Development-mode sign-in ("登入配置 → 開發模式登入"), kept apart from SMS settings.
/// When enabled, new sign-in requests send no SMS and accept the configured code.
/// Only the code's hash is stored and it is never returned by any API.
model PhoneLoginDevelopmentSetting {
  id                   String   @id @default("default")
  enabled              Boolean  @default(false)
  verificationCodeHash String
  updatedAt            DateTime @updatedAt
  updatedBy            String?
}

/// Long-lived sign-in. Only a hash of the bearer token is stored.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

/// What a trip of two legs is: 接駁 (A to B, changing cars at a 接駁位置) or 往返 (A to B and back
/// to A). Every leg of the trip holds it.
enum JourneyKind {
  TRANSFER
  ROUND_TRIP
}

/// 包鐘: costs on the way the passenger pays besides the hours, as the dispatcher lists them
/// (路橋費、停車費、司機膳食). Only stated; the platform never adds them up.
enum CharterExtra {
  TOLLS
  PARKING
  MEALS
}

/// Who may claim an order. TEAM is reserved for the paid team tier.
enum ClaimScope {
  PUBLIC
  TEAM
}

enum Currency {
  HKD
  CNY
  MOP
}

/// Where a car is registered, matching the three plates of a driver profile.
enum PlateRegion {
  HK
  MACAU
  MAINLAND
}

/// How many plates a car carries: one, two (兩地牌) or three (三地牌).
enum PlateType {
  SINGLE
  DUAL
  TRIPLE
}

model Order {
  id                   String        @id @default(cuid())
  /// Unguessable code used in the dispatch link (/o/{code}).
  code                 String        @unique
  /// Unguessable code used in the passenger-confirmation link (/c/{confirmCode}).
  confirmCode          String        @unique
  dispatcherId         String
  scope                ClaimScope    @default(PUBLIC)
  status               OrderStatus   @default(OPEN)
  pickupAt             DateTime
  origin               String
  destination          String
  waypoints            String[]      @default([])
  passengers           Int
  luggage              Int           @default(0)
  vehicleType          String?
  /// What the dispatcher pays the driver, in minor units (cents). Shown in the
  /// group text and on the claim page. Null when left blank.
  driverPriceMinor     Int?
  driverCurrency       Currency      @default(HKD)
  /// What the passenger pays, in minor units. Never shown to drivers.
  passengerPriceMinor  Int?
  passengerCurrency    Currency      @default(HKD)
  /// Whether the passenger-confirmation page shows the passenger price.
  showPassengerPrice   Boolean       @default(false)
  /// Platform service fee charged to the dispatcher's credits when the order
  /// was created; refunded if the order is cancelled. Null when no fee applied.
  commissionMinor      Int?
  notes                String?
  /// The one-line text the order was written from (一句話發單), kept as typed.
  rawText              String?
  /// 航班號 of an airport pickup or drop-off, as the dispatcher typed it. Shown to drivers and in the group text.
  flightNo             String?
  /// 即時單: put out to leave now; pickupAt is when it was put out. Only the first leg of a 接駁 order.
  /// Cleared when 修改行程 sets a time.
  immediate            Boolean   @default(false)
  passengerName        String?
  /// Visible to the dispatcher always; to the driver who claimed the order only
  /// from contactRevealMinutes before pickup (null: as soon as claimed).
  passengerContact     String
  contactRevealMinutes Int?          @default(60)
  /// 接駁: every leg of one trip points at the trip's first leg (the first
  /// leg at itself). Null for an order that is not part of a trip.
  journeyId            String?
  /// Position of this leg in its trip, from 1; null outside a trip.
  legIndex             Int?
  /// What the trip is (接駁 or 往返); null for an order that is not part of a trip.
  journeyKind          JourneyKind?
  /// 往返: one driver takes both legs with one claim (同一位司機來回); false: each leg is claimed
  /// on its own (可分開接), and one driver may take both. Always false outside a 往返.
  sameDriver           Boolean       @default(false)
  /// 包鐘 (按小時計費): the hours booked, in minutes; null for an order that is not 包鐘. The car
  /// is the passenger's from pickupAt for this long, from origin to destination by the waypoints.
  /// driverPriceMinor and passengerPriceMinor hold the hourly prices times the hours.
  charterMinutes       Int?
  /// 包鐘: what the driver is paid an hour, in driverCurrency.
  driverHourlyMinor    Int?
  /// 包鐘: what the passenger pays an hour, in passengerCurrency. Never shown to drivers.
  passengerHourlyMinor Int?
  /// 包鐘 超時: an hour past the hours booked; null means the hourly price.
  overtimeDriverHourlyMinor Int?
  overtimePassengerHourlyMinor Int?
  /// 包鐘 超時: counted by 30 or 60 minutes, and not at all within the grace minutes. Only stated:
  /// what is owed is between the people on the trip.
  overtimeUnitMinutes  Int?
  overtimeGraceMinutes Int?
  /// 包鐘: 另計 costs the passenger pays besides the hours.
  charterExtras        CharterExtra[] @default([])
  /// Plates the car for this order needs (e.g. a Macau car for the leg after a
  /// 接駁). Shown in the group text and on the claim page; never enforced.
  requiredPlates       PlateRegion[] @default([])
  /// 接單池: the dispatcher chose to list this order for every signed-in driver,
  /// besides the groups the link is pasted in. Off unless they tick it.
  inPool               Boolean       @default(false)
  /// 收款方式: the passenger's confirmation page shows the dispatcher's own ways
  /// to be paid. Off unless the dispatcher turns it on for this order (or trip).
  showPaymentMethods   Boolean       @default(false)
  /// 已收款: when the dispatcher marked the fare as received. The dispatcher
  /// checks their own account and marks it; the platform never sees the money.
  paidAt               DateTime?
  /// 已結清: when the dispatcher marked the account with the driver who took this
  /// order as settled. A mark only: who paid whom and how much is between the two
  /// of them, and the platform neither sees the money nor checks it.
  settledAt            DateTime?
  /// 先給常用司機: until then only the dispatcher's 常用司機 may claim it, and the 接單池 shows it only to them.
  favoritesUntil       DateTime?
  claimedById          String?
  claimedAt            DateTime?
  passengerConfirmedAt DateTime?
  /// 出單者代確認: the dispatcher confirmed for a passenger who did not press the link themselves.
  passengerConfirmedByDispatcher Boolean @default(false)
  /// 行程進度, as the driver who took the order reports it: set out, at the pickup, passenger on board.
  departedAt           DateTime?
  arrivedAt            DateTime?
  pickedUpAt           DateTime?
  /// 修改行程: what the dispatcher changed after a driver took the order, until that driver confirms it.
  changeSummary        String?
  changePendingAt      DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  dispatcher  User            @relation("OrderDispatcher", fields: [dispatcherId], references: [id])
  claimedBy   User?           @relation("OrderClaimer", fields: [claimedById], references: [id])
  claims      OrderClaim[]
  journeyHead Order?          @relation("Journey", fields: [journeyId], references: [id])
  booking     BookingRequest?
  journeyLegs Order[]         @relation("Journey")
  tripGroup   TripGroup?
  /// 拼車: the carpool this order was made from; its seats are the order's passengers.
  carpool     Carpool?

  @@unique([journeyId, legIndex])
  @@index([dispatcherId, createdAt])
  @@index([claimedById, createdAt])
  @@index([inPool, status, pickupAt])
}

/// 我的司機: a dispatcher's own mark and note on a driver who took one of their orders. Seen only by them.
model DriverNote {
  ownerId   String
  driverId  String
  /// 常用司機: offered the dispatcher's orders first when they choose 先給常用司機.
  favorite  Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt

  owner  User @relation("DriverNoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  driver User @relation("DriverNoteDriver", fields: [driverId], references: [id], onDelete: Cascade)

  @@id([ownerId, driverId])
  @@index([driverId])
}

enum ClaimResult {
  WON
  LOST
}

/// Every claim attempt, won or lost, kept as evidence for disputes.
model OrderClaim {
  id         String      @id @default(cuid())
  orderId    String
  driverId   String
  result     ClaimResult
  createdAt  DateTime    @default(now())
  /// 取消接單: when the driver gave a won claim back.
  releasedAt DateTime?

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver User  @relation(fields: [driverId], references: [id])

  @@index([orderId, createdAt])
  @@index([driverId, createdAt])
}

// ---------------------------------------------------------------------------
// Billing control (entitlements). Payment providers only feed Subscription;
// whether a feature is usable is always decided here.
// ---------------------------------------------------------------------------

enum FeatureKind {
  SWITCH
  QUOTA
}

model Feature {
  key         String      @id
  name        String
  kind        FeatureKind
  description String?

  planFeatures PlanFeature[]
}

model Plan {
  key       String  @id
  name      String
  rank      Int
  isDefault Boolean @default(false)

  features      PlanFeature[]
  subscriptions Subscription[]
}

model PlanFeature {
  planKey    String
  featureKey String
  enabled    Boolean @default(true)
  /// Monthly quota for QUOTA features. Null means unlimited.
  quota      Int?

  plan    Plan    @relation(fields: [planKey], references: [key], onDelete: Cascade)
  feature Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([planKey, featureKey])
}

enum SubscriptionSource {
  STRIPE
  ALIPAY_HK
  MANUAL
  GIFT
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  planKey                String
  source                 SubscriptionSource
  status                 SubscriptionStatus @default(ACTIVE)
  startsAt               DateTime
  endsAt                 DateTime?
  externalCustomerId     String?
  externalSubscriptionId String?            @unique
  note                   String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planKey], references: [key])

  @@index([userId, status])
}

/// Site-wide switches. With planKey set, everyone gets that plan's features
/// (e.g. the launch free period). With featureKey set, that one feature is free
/// and unlimited for everyone.
model BillingPolicy {
  id         String    @id @default(cuid())
  name       String
  planKey    String?
  featureKey String?
  startsAt   DateTime
  endsAt     DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

/// Per-user grants: a trial, a gift, or a Master Travel customer upgrade.
model EntitlementOverride {
  id         String    @id @default(cuid())
  userId     String
  planKey    String?
  featureKey String?
  enabled    Boolean?
  quota      Int?
  startsAt   DateTime
  endsAt     DateTime?
  reason     String
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Quota consumption per calendar month (period = "YYYY-MM", Hong Kong time).
model Usage {
  userId     String
  featureKey String
  period     String
  used       Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, featureKey, period])
}

// ---------------------------------------------------------------------------
// Platform service fee (抽水) and prepaid credits. The fee is a fixed amount per
// order charged to the dispatcher, never to the driver who claims it. It is a
// fee for using the tool, not a share of the fare: the platform never handles
// fares.
// ---------------------------------------------------------------------------

/// Site-wide switch and amount, set in the platform admin. Off by default.
model CommissionSetting {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  feeMinor  Int      @default(0)
  currency  Currency @default(HKD)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model CreditAccount {
  userId       String   @id
  balanceMinor Int      @default(0)
  currency     Currency @default(HKD)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CreditEntryType {
  TOPUP
  CHARGE
  REFUND
  ADJUST
}

/// Every change to a balance. amountMinor is signed: top-ups and refunds are
/// positive, charges negative. An order is charged and refunded at most once.
model CreditEntry {
  id                String          @id @default(cuid())
  userId            String
  type              CreditEntryType
  amountMinor       Int
  balanceAfterMinor Int
  orderId           String?
  /// For top-ups: STRIPE, ALIPAY_HK or MANUAL.
  source            String?
  note              String?
  createdBy         String?
  createdAt         DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Platform admin. Accounts and sessions are separate from drivers' accounts.
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
  SALES
}

model Administrator {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  /// scrypt hash; the password itself is never stored or logged.
  passwordHash String
  role         AdminRole
  disabledAt   DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        AdminSession[]
  auditLogs       AdminAuditLog[]
  supportMessages SupportMessage[]
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  admin Administrator @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

/// Every admin sign-in attempt and every change made in the admin. Details never
/// contain passwords, keys or verification codes.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  targetType String?
  targetId   String?
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now())

  admin Administrator? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Site settings, SEO, ad slots and sales leads — all edited in the platform admin.
// ---------------------------------------------------------------------------

/// General settings shown in the driver app and on public pages.
model AppSetting {
  id                  String   @id @default("default")
  /// Where every "upgrade to Master Travel" prompt and ad link points (預約演示).
  upgradeUrl          String   @default("")
  supportWechatId     String   @default("")
  supportWhatsapp     String   @default("")
  termsText           String   @default("")
  privacyText         String   @default("")
  announcementText    String   @default("")
  announcementEnabled Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  updatedBy           String?
}

/// 更新說明彈窗 (2026-10-21): a picture the admin uploads in 一般設定, shown once to every
/// driver in the app like an ad, closed with one tap. Each new picture raises the version,
/// so everyone sees it once more. A Simplified picture is optional; without it everyone gets
/// the Traditional one. Kept apart from AppSetting so reading the settings never carries images.
model UpdateNotice {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  version   Int      @default(0)
  hantMime  String?
  hantImage Bytes?
  hansMime  String?
  hansImage Bytes?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// The platform's logo, uploaded in the admin (一般設定) and shown on the public
/// home page, the sign-in page and claim pages. Kept apart from AppSetting so
/// reading the settings never carries the image.
model SiteLogo {
  id        String   @id @default("default")
  mime      String
  image     Bytes
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Limits against abuse (防濫用設定), changed in the platform admin and applied at
/// once. The defaults here are the values the code used before they moved here.
model LimitSetting {
  id                                   String   @id @default("default")
  /// 客服: pictures a guest conversation may send in 24 hours (guests send no video).
  supportGuestMediaPerDay              Int      @default(10)
  /// 客服: pictures and videos a signed-in user may send in 24 hours.
  supportUserMediaPerDay               Int      @default(30)
  /// 客服: messages a user or guest may send in one conversation per minute.
  supportMessagesPerMinute             Int      @default(20)
  /// 客服: guest conversations one address may open in 24 hours.
  supportGuestConversationsPerIpPerDay Int      @default(5)
  /// 名片頁: booking requests one address may send in 24 hours.
  bookingPerIpPerDay                   Int      @default(5)
  /// 名片頁: booking requests one page may receive in 24 hours.
  bookingPerPagePerDay                 Int      @default(30)
  /// 特價車 (2026-10-22): bookings one passenger phone may send in 24 hours, over every deal.
  /// Counted apart from 名片頁 requests, and by phone: on mainland mobile networks many share an address.
  dealBookingPerPhonePerDay            Int      @default(5)
  /// 特價車: bookings one address may send in 24 hours; only against floods, so set wide.
  dealBookingPerIpPerDay               Int      @default(50)
  /// 特價車: bookings one driver's deals may receive in 24 hours.
  dealBookingPerDriverPerDay           Int      @default(200)
  /// 簡訊驗證碼: seconds before the same number may ask for another code.
  otpResendSeconds                     Int      @default(60)
  /// 簡訊驗證碼: codes one number may ask for in an hour.
  otpPerPhonePerHour                   Int      @default(5)
  /// 簡訊驗證碼: codes one address may ask for in an hour.
  otpPerIpPerHour                      Int      @default(20)
  updatedAt                            DateTime @updatedAt
  updatedBy                            String?
}

/// Site-wide SEO. The claim page (/o/), passenger page (/c/), driver app and admin
/// are always noindex in code; nothing here can change that.
model SeoSiteSetting {
  id                 String   @id @default("default")
  /// e.g. https://example.com — used for canonical links and the sitemap.
  canonicalOrigin    String   @default("")
  googleVerification String   @default("")
  bingVerification   String   @default("")
  baiduVerification  String   @default("")
  /// Baidu Tongji site id only (not a script), since Google Analytics is unreachable in the mainland.
  baiduTongjiId      String   @default("")
  allowIndexing      Boolean  @default(false)
  sitemapEnabled     Boolean  @default(false)
  updatedAt          DateTime @updatedAt
  updatedBy          String?
}

enum SeoPage {
  HOME
  PROFILE
}

/// Per page type. PROFILE texts are templates: {司機} {路線} {車型} {地區}.
model SeoPageSetting {
  page          SeoPage  @id
  title         String   @default("")
  description   String   @default("")
  keywords      String   @default("")
  shareImageUrl String   @default("")
  updatedAt     DateTime @updatedAt
}

enum AdPosition {
  CLAIM_PAGE
  HOME
  MY_ORDERS
}

/// Promotion of Master Travel. Never shown on passenger pages.
model AdSlot {
  id        String     @id @default(cuid())
  position  AdPosition
  title     String
  body      String     @default("")
  imageUrl  String     @default("")
  /// https only; clicks go through /api/public/ads/{id}/click to be counted.
  linkUrl   String
  priority  Int        @default(0)
  active    Boolean    @default(true)
  startsAt  DateTime   @default(now())
  endsAt    DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  stats AdStat[]

  @@index([position, active])
}

/// Daily counts per ad, so impressions do not grow a row per view.
model AdStat {
  adId        String
  day         String
  impressions Int    @default(0)
  clicks      Int    @default(0)

  ad AdSlot @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([adId, day])
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  CONVERTED
  NOT_INTERESTED
}

/// Sales follow-up on a dispatcher who may become a Master Travel customer.
model Lead {
  userId    String     @id
  status    LeadStatus @default(NEW)
  note      String     @default("")
  updatedAt DateTime   @updatedAt
  updatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Payment and SMS channels (same providers as Master Travel, separate settings).
// Secret fields hold AES-256-GCM ciphertext ("v1.<iv>.<tag>.<data>"), never plain
// text, and are never returned by any API.
// ---------------------------------------------------------------------------

enum PaymentProvider {
  STRIPE
  ALIPAY_HK
}

model PaymentChannel {
  id               String          @id @default(cuid())
  provider         PaymentProvider
  /// "sandbox" or "production"; one saved configuration per environment.
  environment      String
  /// The configuration future online payments use. At most one per provider.
  enabled          Boolean         @default(false)
  // Stripe
  publishableKey   String?
  secretKeyEnc     String?
  webhookSecretEnc String?
  paymentMethods   String[]        @default([])
  // AlipayHK
  gatewayUrl       String?
  partner          String?
  appId            String?
  privateKeyEnc    String?
  publicKeyEnc     String?
  notifyUrl        String?
  returnUrl        String?
  lastTestedAt     DateTime?
  lastTestStatus   String?
  lastTestMessage  String?
  updatedAt        DateTime        @updatedAt
  updatedBy        String?

  @@unique([provider, environment])
}

/// DOMESTIC sends to +86 numbers; INTERNATIONAL to +852 and +853 (253 雲通訊).
enum SmsRoute {
  DOMESTIC
  INTERNATIONAL
}

/// Who sends for a route. SMS253: 253 雲通訊, under our own registered signature.
/// SPUG: Spug 推送助手, under Spug's signature and fixed template, for numbers we
/// have no registration for.
enum SmsProviderKind {
  SMS253
  SPUG
}

/// One per route (+86, and +852 / +853): which provider sends its sign-in codes, and the
/// route's own 253 account. Choosing Spug for a route leaves its 253 account as it is.
model SmsChannel {
  route           SmsRoute        @id
  /// The provider that sends this route's codes. Each keeps its own settings.
  provider        SmsProviderKind @default(SMS253)
  /// This route's 253 account is switched on.
  enabled         Boolean         @default(false)
  endpoint        String          @default("")
  account         String          @default("")
  passwordEnc     String?
  /// Must contain {code}.
  template        String          @default("")
  testPhone       String          @default("")
  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestMessage String?
  updatedAt       DateTime        @updatedAt
  updatedBy       String?
}

/// Spug 推送助手, set up once for both routes and kept apart from the 253 accounts. A route
/// sends through it only when the route chooses Spug and this is switched on.
model SpugSetting {
  id              String    @id @default("default")
  enabled         Boolean   @default(false)
  endpoint        String    @default("https://push.spug.cc")
  /// No longer used: Spug's /sms official templates take no application name (2026-10-14).
  appName         String    @default("")
  /// The template code: whoever has it can send, so it is kept like a password.
  templateCodeEnc String?
  testPhone       String    @default("")
  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestMessage String?
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
}

/// One row per SMS attempt. The verification code itself is never stored.
model SmsMessage {
  id            String          @id @default(cuid())
  route         SmsRoute
  provider      SmsProviderKind @default(SMS253)
  countryCode   String
  phone         String
  purpose       String
  status        String
  providerCode  String?
  providerError String?
  createdAt     DateTime        @default(now())

  @@index([createdAt])
  @@index([countryCode, phone, createdAt])
}

// ---------------------------------------------------------------------------
// Dispatchers' own WeChat / WhatsApp groups, offered on their claim pages so
// drivers who open a link can join the group ("拉群").
// ---------------------------------------------------------------------------

/// WECHAT: a group QR (expires after 7 days, and groups over 200 members cannot be
/// joined by QR). WECHAT_CONTACT: the dispatcher's own WeChat QR, "add me and I'll
/// pull you in" — it does not expire, so it suits big groups. WHATSAPP: an invite link.
/// 收款方式: how a dispatcher can be paid. Not the platform's own payment
/// channels (PaymentChannel); the money goes straight to the dispatcher.
enum PaymentKind {
  WECHAT
  ALIPAY
  PAYME
  FPS
  BANK
  OTHER
}

model PaymentMethod {
  id        String      @id @default(cuid())
  ownerId   String
  kind      PaymentKind
  /// What the passenger sees above it, e.g. "微信收款" or the account holder's name.
  label     String
  /// Typed account details: an FPS ID, a PayMe phone, a bank and account number.
  account   String?
  /// A payment QR code (PNG/JPEG/WebP, at most 400 KB), shown only through the
  /// confirmation link of an order that shows payment methods.
  qrImage   Bytes?
  qrMime    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

/// 行程群: a group the dispatcher made themselves for one trip, with the
/// passenger and the driver in it. The platform only passes on the way in: a
/// WhatsApp invite link, or a WeChat group QR (which stops working after 7
/// days). One per trip: orderId is the single order, or the first leg of a 接駁
/// trip. The image is read only when it is asked for, never with the order.
model TripGroup {
  orderId   String            @id
  platform  TripGroupPlatform
  inviteUrl String?
  qrImage   Bytes?
  qrMime    String?
  expiresAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum TripGroupPlatform {
  WHATSAPP
  WECHAT
}

enum GroupPlatform {
  WECHAT
  WHATSAPP
  WECHAT_CONTACT
}

model GroupInvite {
  id              String        @id @default(cuid())
  ownerId         String
  platform        GroupPlatform
  name            String
  /// WhatsApp invite link (https://chat.whatsapp.com/…). Not used for WeChat.
  inviteUrl       String?
  /// WeChat group QR image (PNG/JPEG/WebP, at most 400 KB). Moves to Cloud Storage later.
  qrImage         Bytes?
  qrMime          String?
  /// WeChat group QR codes stop working 7 days after they are generated.
  expiresAt       DateTime?
  showOnClaimPage Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Customer support (內置客服): conversations between the platform's staff and
// a signed-in user or a guest. Rewritten after Master Travel's internal support.
// ---------------------------------------------------------------------------

enum SupportMessageKind {
  TEXT
  IMAGE
  VIDEO
}

/// One conversation per signed-in user, or per guest token. A guest who later
/// signs in starts the user's own conversation; the two are never merged.
model SupportConversation {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  /// Hash of the random token a guest keeps in the browser; the token itself is never stored.
  guestTokenHash      String?   @unique
  /// Limits how many guest conversations one address can open.
  guestIp             String?
  /// The last message came from the user or guest and no staff has answered it.
  waiting             Boolean   @default(false)
  /// Staff messages the user or guest has not opened yet.
  unreadByParticipant Int       @default(0)
  /// Messages from the user or guest no staff member has opened yet (the inbox is shared, so one look clears it).
  unreadByStaff       Int       @default(0)
  lastMessageAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]
  media    SupportMedia[]

  @@index([waiting, lastMessageAt])
  @@index([lastMessageAt])
  @@index([guestIp, createdAt])
}

model SupportMessage {
  id              String             @id @default(cuid())
  /// Order of messages across the table; clients page and poll by it.
  seq             Int                @unique @default(autoincrement())
  conversationId  String
  fromStaff       Boolean
  /// The administrator who replied; null for the user's or guest's own messages.
  staffId         String?
  kind            SupportMessageKind @default(TEXT)
  text            String             @default("") @db.Text
  /// Chosen by the sender, so a retried request never posts the message twice.
  clientMessageId String
  mediaId         String?            @unique
  createdAt       DateTime           @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staff        Administrator?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  media        SupportMedia?       @relation(fields: [mediaId], references: [id])

  @@unique([conversationId, fromStaff, clientMessageId])
  @@index([conversationId, seq])
}

/// A picture or video sent in a conversation. Only this record is in the
/// database; the bytes are in private storage under storageKey and are served
/// through the API to the conversation's participant and to staff only.
model SupportMedia {
  id             String             @id
  conversationId String
  kind           SupportMessageKind
  mimeType       String
  sizeBytes      Int
  storageKey     String             @unique
  /// SHA-256 of the stored bytes.
  checksum       String
  createdAt      DateTime           @default(now())
  /// The bytes are removed after this time; the message stays.
  expiresAt      DateTime
  deletedAt      DateTime?

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      SupportMessage?

  @@index([conversationId, createdAt])
  @@index([expiresAt, deletedAt])
}

// ---------------------------------------------------------------------------
// 名片頁 and booking requests: a driver's own public page, where a passenger
// can ask for a trip. The platform lists nobody, sets no price and takes no
// payment; the driver answers each request personally.
// ---------------------------------------------------------------------------

/// One page per user. The name and vehicle come from DriverProfile; what is
/// here is what only the page shows.
model ProfilePage {
  id            String    @id @default(cuid())
  userId        String    @unique
  /// Unguessable code in the page's address (/p/{code}).
  code          String    @unique
  /// Nobody but the owner sees the page until it is published.
  published     Boolean   @default(false)
  /// 讓搜尋引擎找到我 (2026-10-22): the driver lets search engines index the published page and
  /// list it in the sitemap, while the platform's SEO setting allows indexing. Off by default.
  searchable    Boolean   @default(false)
  intro         String    @default("")
  routes        String[]  @default([])
  languages     String[]  @default([])
  regions       String[]  @default([])
  wechatId      String    @default("")
  whatsapp      String    @default("")
  /// 下架: the platform's staff took the page down after a complaint. The owner cannot publish
  /// it again until staff restore it, and its photos are not shown to passengers either.
  blockedAt     DateTime?
  blockedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos   ProfilePhoto[]
  bookings BookingRequest[]
}

/// A vehicle photo. The bytes are in the media storage under storageKey and
/// are served through the API while the page is published.
model ProfilePhoto {
  id         String   @id
  pageId     String
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  page ProfilePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
}

enum BookingStatus {
  /// Sent by the passenger; the driver has not answered.
  PENDING
  /// The driver quoted a price.
  QUOTED
  /// The passenger agreed to the quote.
  ACCEPTED
  /// The driver made it into an order.
  ORDERED
  /// The driver cannot take it.
  DECLINED
  /// The passenger withdrew it.
  CANCELLED
}

model BookingRequest {
  id               String        @id @default(cuid())
  pageId           String
  /// Unguessable code of the passenger's own link (/b/{code}).
  code             String        @unique
  status           BookingStatus @default(PENDING)
  pickupAt         DateTime
  origin           String
  destination      String
  passengers       Int
  luggage          Int           @default(0)
  /// 接駁 (中途換車) rather than 直達, as the passenger asked; the driver sets the 接駁位置 when making the order.
  transfer         Boolean       @default(false)
  /// 往返 (there and back) rather than 直達, as the passenger asked; returnPickupAt is the way back.
  roundTrip        Boolean       @default(false)
  returnPickupAt   DateTime?
  /// 往返: where the way back leaves from and goes to, when not the way there reversed; null
  /// means reversed.
  returnOrigin     String?
  returnDestination String?
  passengerName    String?
  /// A phone with its country code since 2026-10-14; older requests may hold any text.
  passengerContact String
  /// Optional, only the driver sees it.
  passengerWechat  String?
  notes            String?
  /// The driver's quote; what the passenger pays is agreed between the two of them.
  quoteMinor       Int?
  quoteCurrency    Currency      @default(HKD)
  quoteNote        String?
  quotedAt         DateTime?
  /// Something the driver has not opened yet: a new request, or the passenger's answer.
  driverUnread     Boolean       @default(true)
  /// The order made from this request; its confirmation page is where the passenger continues.
  orderId          String?       @unique
  /// Where the passenger came from (?from= on the page link), for the driver's own counting.
  source           String?
  /// 特價車: sent from that deal's link at its price (quoteMinor), which the driver cannot change.
  dealId           String?
  ip               String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  page  ProfilePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  order Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  deal  Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@index([dealId, status])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// 通知: what happened to the user's orders, bookings and 客服 conversation, shown under the
// bell while the app is open. There is no push to a closed page, SMS or WeChat message.
// ---------------------------------------------------------------------------

/**
 * The groups a user can turn off in 通知設定.
 */
enum NotificationGroup {
  /// Orders the user put out.
  DISPATCHED
  /// Orders the user claimed.
  CLAIMED
  /// Booking requests from the user's 名片頁, and seats asked for on their 拼車.
  BOOKINGS
  /// 客服 replies.
  SUPPORT
}

enum NotificationKind {
  /// To the dispatcher: a driver claimed the order.
  ORDER_CLAIMED
  /// To the dispatcher: the passenger confirmed the trip.
  ORDER_CONFIRMED
  /// To whichever of the dispatcher and the driver did not mark the trip done.
  ORDER_COMPLETED
  /// To the driver: the dispatcher (or the platform's staff for them) cancelled the order.
  ORDER_CANCELLED
  /// To the dispatcher: the platform's staff cancelled their order.
  ORDER_CANCELLED_BY_STAFF
  /// To the driver: the dispatcher took the order back to give it to someone else (改派).
  ORDER_REOPENED
  /// To the dispatcher: the driver gave the order (or their leg of a 接駁 order) back; it is open again.
  ORDER_RELEASED
  /// To the dispatcher: an open order (or leg) still has no driver close to its time.
  ORDER_UNCLAIMED
  /// To the driver: the dispatcher changed the trip they took; they confirm with 知道了.
  ORDER_CHANGED
  /// To the dispatcher: the driver confirmed the change.
  ORDER_CHANGE_ACKED
  /// To the driver: the dispatcher marked the account settled.
  ORDER_SETTLED
  /// To the driver: the passenger's phone is now shown on the order.
  CONTACT_REVEALED
  /// To the 名片頁 owner.
  BOOKING_NEW
  BOOKING_ACCEPTED
  BOOKING_CANCELLED
  /// To the driver who opened a 拼車: a passenger asked for seats (confirmed at once, or waiting for them).
  CARPOOL_SEAT_NEW
  CARPOOL_SEAT_WAITING
  /// To the driver: a passenger cancelled their seats.
  CARPOOL_SEAT_CANCELLED
  /// To the driver: confirmed passengers reached the least the carpool goes with.
  CARPOOL_FORMED
  /// To the driver: the time to ask for seats ran out.
  CARPOOL_CLOSED
  /// To the driver who put up a 特價車: a passenger booked it and waits for them.
  DEAL_BOOKING_NEW
  /// To the driver: a passenger booked it and has it at once (自動接受); the order is the driver's to make.
  DEAL_BOOKING_ACCEPTED
  /// 客服 answered; one line until the user reads it, however many messages.
  SUPPORT_REPLY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  /// Where tapping it goes. Kept as plain ids: the line stays even if what it points to is gone.
  orderId   String?
  bookingId String?
  carpoolId String?
  /// The trip it is about, copied when sent ("深圳灣口岸 至 香港國際機場") with its pickup time.
  summary   String           @default("")
  pickupAt  DateTime?
  /// Set on notifications that must be sent once only (the passenger's phone shown for one claim).
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 數據流監控 (platform admin). Each API instance counts requests in memory and adds them here
// every 15 seconds, and writes its live state, so the page sees every instance. No IP address
// is stored: only the region it resolved to.
// ---------------------------------------------------------------------------

/// Completed requests per day in Hong Kong time. Counts of requests, not people.
model ObservabilityRequestStat {
  day          DateTime @db.Date
  /// "中国 · 广东", "香港", "本機／內網", "未知地區".
  region       String
  /// MAINLAND, HONG_KONG, MACAU, OTHER, INTERNAL, UNKNOWN.
  area         String
  /// driver, passenger, admin, backend.
  source       String
  /// WECHAT, WHATSAPP, BROWSER (another browser), NONE (no browser: probes, servers).
  client       String
  /// application, or health for the platform's own checks.
  category     String
  count        Int      @default(0)
  /// Answered 500 or above.
  errors       Int      @default(0)
  /// Answered 400 to 499.
  clientErrors Int      @default(0)
  /// Took 800 ms or more.
  slow         Int      @default(0)
  totalMs      BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@id([day, region, area, source, client, category])
}

/// One API instance's live state: who was active in the last 5 minutes and which notification
/// streams are open. The page adds up the instances written in the last 45 seconds.
model ObservabilityInstance {
  id        String   @id
  startedAt DateTime
  updatedAt DateTime
  presence  Json
  streams   Int      @default(0)

  @@index([updatedAt])
}

enum CarpoolStatus {
  /// Taking seats until closesAt (past it, the carpool reads as closed).
  OPEN
  /// The driver stopped taking seats; it can open again with a later closesAt.
  CLOSED
  /// Made into an order (driven by the driver, or put out for others); the order carries it on.
  ORDERED
  CANCELLED
}

/// 拼車: a trip a driver opens for several parties of passengers, who ask for seats through the
/// link the driver gives them (/r/{code}). Nobody else lists or matches it: the platform only
/// keeps the seats. Closed, it becomes one order the driver drives or puts out.
model Carpool {
  id                 String        @id @default(cuid())
  /// Unguessable code of the link the driver gives passengers (/r/{code}).
  code               String        @unique
  driverId           String
  status             CarpoolStatus @default(OPEN)
  pickupAt           DateTime
  origin             String
  destination        String
  /// 上車點 the passenger chooses from; empty: each passenger types theirs.
  pickupPoints       String[]      @default([])
  /// Seats for passengers: no more than the car's seats less the driver's.
  seats              Int
  /// 最少成行人數: confirmed passengers it goes with; null: any.
  minPassengers      Int?
  /// 每位價錢, set by the driver; the platform neither suggests nor takes it. Null: 私訊報價.
  seatPriceMinor     Int?
  seatCurrency       Currency      @default(HKD)
  /// 每位行李 the driver allows; null: not said.
  luggagePerSeat     Int?
  /// The driver's own words on cancelling; shown to passengers, never enforced.
  cancelPolicy       String?
  notes              String?
  /// 報位截止: seats are asked for until then.
  closesAt           DateTime
  /// Seats are confirmed as soon as they are asked for; otherwise the driver confirms each.
  autoConfirm        Boolean       @default(false)
  /// 等候時間: how long after reaching a pickup the driver may mark its passengers as not there.
  waitMinutes        Int           @default(15)
  /// 收款方式: passengers' links show the driver's own ways to be paid.
  showPaymentMethods Boolean       @default(false)
  /// 成行: when confirmed passengers last reached minPassengers (told once); cleared when they drop below.
  formedAt           DateTime?
  closedAt           DateTime?
  cancelledAt        DateTime?
  /// The order it was made into.
  orderId            String?       @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  driver    User          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  seatsList CarpoolSeat[]

  @@index([driverId, createdAt])
  @@index([status, closesAt])
}

enum CarpoolSeatStatus {
  /// Waiting for the driver; holds its seats until expiresAt.
  PENDING
  CONFIRMED
  /// The driver said no.
  DECLINED
  /// The driver did not answer in time.
  EXPIRED
  /// The passenger withdrew.
  CANCELLED
  /// The driver took it off the carpool after confirming it.
  REMOVED
}

/// One party of passengers on a 拼車, and how their part of the trip went.
model CarpoolSeat {
  id               String            @id @default(cuid())
  carpoolId        String
  /// Unguessable code of the passenger's own link (/s/{code}); the link is their credential.
  code             String            @unique
  status           CarpoolSeatStatus @default(PENDING)
  passengers       Int
  luggage          Int               @default(0)
  pickupPoint      String
  /// Where they get off; null: the carpool's destination.
  dropoff          String?
  passengerName    String
  /// A phone with its country code, as on an order.
  passengerContact String
  passengerWechat  String?
  notes            String?
  ip               String?
  /// A PENDING seat stops holding its seats then.
  expiresAt        DateTime?
  /// The driver changed the time or the price after this seat was asked for; the passenger has not accepted yet.
  reconfirmAt      DateTime?
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  /// 行程進度 of this party, as the driver reports it.
  arrivedAt        DateTime?
  pickedUpAt       DateTime?
  noShowAt         DateTime?
  droppedAt        DateTime?
  /// 已收款: the driver (dispatcher) checked their own account and marked this party's fare received.
  paidAt           DateTime?
  /// Something the driver has not opened yet.
  driverUnread     Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  carpool Carpool @relation(fields: [carpoolId], references: [id], onDelete: Cascade)

  @@index([carpoolId, status])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// 特價車 (docs/DECISIONS.md, 2026-10-21, 2026-10-22): a trip a driver offers at a price of their
// own, whole car, for each party; like a product, any number of parties book it from the driver's
// link, each its own order, until the driver closes it. Bookings are BookingRequest rows with
// dealId, so the driver answers them where they answer 名片頁 requests. The platform never
// lists, recommends or prices a deal.
// ---------------------------------------------------------------------------

enum DealStatus {
  /// Takes bookings until its last pickup time (then it reads as expired), or while fewer than
  /// maxBookings parties hold one (then it reads as full).
  OPEN
  /// 關閉 by the driver: no new bookings; the ones sent are answered as before.
  CLOSED
  /// 下架 by the platform's staff after a complaint; the bookings still waiting are declined.
  CANCELLED
}

model Deal {
  id                  String     @id @default(cuid())
  /// Unguessable code of the link the driver gives passengers (/d/{code}).
  code                String     @unique
  driverId            String
  status              DealStatus @default(OPEN)
  /// The pickup time, or the start of 時段 when pickupUntil is set; each party picks theirs in it.
  pickupAt            DateTime
  /// 時段: the passenger picks a time from pickupAt to this; null: pickupAt exactly.
  pickupUntil         DateTime?
  origin              String
  destination         String
  /// 包車特價 a party, set by the driver; the platform neither suggests nor takes it.
  priceMinor          Int
  currency            Currency   @default(CNY)
  /// 原價, shown struck through; the driver's own figure, above the price.
  originalPriceMinor  Int?
  /// 最多幾人、幾件行李; null: not said.
  maxPassengers       Int?
  maxLuggage          Int?
  notes               String?
  /// 最多接幾組 (庫存): parties waiting, booked or ordered count; null: no limit.
  maxBookings         Int?
  /// 自動接受: each booking is accepted as it comes; otherwise the driver answers each.
  autoAccept          Boolean    @default(false)
  closedAt            DateTime?
  cancelledAt         DateTime?
  /// Why the platform's staff took it down.
  staffReason         String?
  /// 刪除 by the driver (2026-10-22): gone from their list and its link, taking no bookings; kept
  /// so the bookings and orders made from it still say they came from a 特價車.
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  driver   User             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  bookings BookingRequest[]

  @@index([driverId, createdAt])
}
