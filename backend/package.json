{
  "name": "masterdriver-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ../prisma/schema.prisma",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run prisma:generate",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "pretest:db": "npm run prisma:generate",
    "test:db": "tsx --test --test-concurrency=1 \"src/**/*.db-test.ts\"",
    "start": "node dist/main.js",
    "dev-login": "tsx src/cli/development-login.ts",
    "billing": "tsx src/cli/billing.ts"
  },
  "dependencies": {
    "@masterdriver/shared": "0.1.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
