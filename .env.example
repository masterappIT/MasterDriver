# Copy to .env for local development. Never commit .env: this repository is public.

# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://master_driver:master_driver@localhost:5434/master_driver
# Separate database used by `npm run test:api:db` (created automatically by the test setup)
TEST_DATABASE_URL=postgresql://master_driver:master_driver@localhost:5434/master_driver_test

PORT=3020

# Base URL used in dispatch and passenger-confirmation links
PUBLIC_BASE_URL=http://localhost:5180

# Secret mixed into verification-code hashes. Use a long random value in every real environment.
OTP_PEPPER=change-me-local-only

# Encrypts payment keys and SMS passwords stored in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production (from Secret Manager). Changing it makes saved secrets unreadable.
DATA_ENCRYPTION_KEY=

# Development only: print verification codes to the API log instead of sending SMS.
# Ignored when NODE_ENV=production.
DEV_LOG_OTP=true

# Set to true behind HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false

# 客服 pictures and videos, and 名片頁 photos. Cloud Run: the name of a private Cloud
# Storage bucket (the API's service account needs roles/storage.objectAdmin on it).
SUPPORT_MEDIA_BUCKET=
# Or a directory for the files: the server's backed-up disk (deploy/hostkvm), or locally
# (default .data/support-media). A bucket, when set, wins. Production with neither
# accepts text only.
SUPPORT_MEDIA_DIR=

# 客服 is MasterBox Chat Box's website widget (2026-11-18). From MasterBox's 管理網頁 →
# 「API 與 Webhook」: the App ID and the signing secret (mbs_...), used only to sign a
# signed-in driver's credential here; nothing is sent to MasterBox. Leave empty and every
# driver chats as an anonymous visitor. Never commit the secret.
MASTERBOX_APP_ID=
MASTERBOX_SIGNING_SECRET=
# The same key's API key (2026-11-20): drivers' details are sent to MasterBox
# (PUT /customers/{id}) and a deleted account's MasterBox data is deleted with it.
# Empty: nothing is sent. Define the 7 客戶欄位 in MasterBox first (docs/DEVELOPMENT.md, 客服).
MASTERBOX_API_KEY=
# The webhook's signing secret (whsec_...), for 「客服回覆了你」 notifications.
# Empty: /api/support/masterbox-webhook answers 404.
MASTERBOX_WEBHOOK_SECRET=
# The platform admin's address, for the link to a driver's page MasterBox staff see.
ADMIN_BASE_URL=
