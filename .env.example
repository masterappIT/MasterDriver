# Copy to .env for local development. Never commit .env: this repository is public.

# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://master_driver:master_driver@localhost:5434/master_driver
# Separate database used by `npm run test:api:db` (created automatically by the test setup)
TEST_DATABASE_URL=postgresql://master_driver:master_driver@localhost:5434/master_driver_test

PORT=3020

# Base URL used in dispatch and passenger-confirmation links
PUBLIC_BASE_URL=http://localhost:5180

# Secret mixed into verification-code hashes. Use a long random value in every real environment.
OTP_PEPPER=change-me-local-only

# Encrypts payment keys and SMS passwords stored in the database. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production (from Secret Manager). Changing it makes saved secrets unreadable.
DATA_ENCRYPTION_KEY=

# Development only: print verification codes to the API log instead of sending SMS.
# Ignored when NODE_ENV=production.
DEV_LOG_OTP=true

# Set to true behind HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false
